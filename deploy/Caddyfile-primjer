# Pjesme Print na putanji postojeće domene koju poslužuje Caddy,
# npr. https://josip.cloud/print_pjesme
#
# Ove dvije direktive dodaj UNUTAR postojećeg site bloka za domenu
# u /etc/caddy/Caddyfile:
#
#   josip.cloud {
#       # ...postojeća konfiguracija...
#
#       redir /print_pjesme /print_pjesme/
#       handle_path /print_pjesme/* {
#           reverse_proxy 127.0.0.1:8010
#       }
#   }
#
# handle_path automatski skida prefiks /print_pjesme prije prosljeđivanja,
# a aplikacija je pripremljena za rad iza prefiksa.
#
# Napomena: ako postojeći blok na korijenu (/) poslužuje drugu aplikaciju
# "golom" reverse_proxy ili file_server direktivom, umotaj je u
# handle { ... } da se rute uredno razdvoje, npr:
#
#   josip.cloud {
#       redir /print_pjesme /print_pjesme/
#       handle_path /print_pjesme/* {
#           reverse_proxy 127.0.0.1:8010
#       }
#       handle {
#           reverse_proxy 127.0.0.1:3000   # postojeća aplikacija na /
#       }
#   }
#
# ── Varijanta: vlastita poddomena (npr. print.josip.cloud) ────────────────────
# 1. U DNS-u domene dodaj A zapis:  print  ->  IP adresa VPS-a
# 2. U /etc/caddy/Caddyfile dodaj NOVI site blok (izvan postojećeg):
#
#   print.josip.cloud {
#       reverse_proxy 127.0.0.1:8010
#   }
#
# Caddy automatski pribavlja i obnavlja HTTPS certifikat za poddomenu
# (DNS mora već pokazivati na server, portovi 80 i 443 otvoreni).
# Poddomena i putanja /print_pjesme mogu raditi istovremeno.

# Provjera i primjena izmjena:
#   caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy
