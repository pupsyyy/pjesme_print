# Systemd servis za Pjesme Print (opcija bez Dockera)
# Kopiraj u /etc/systemd/system/pjesme.service pa:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pjesme

[Unit]
Description=Pjesme Print - PDF u Word konverter
After=network.target

[Service]
User=pjesme
Group=pjesme
WorkingDirectory=/opt/pjesme_print
Environment="MAX_UPLOAD_MB=50"
ExecStart=/opt/pjesme_print/venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 2 --timeout 300 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
